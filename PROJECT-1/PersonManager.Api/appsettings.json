{
	"Serilog": {
		// 최소 로그 레벨. Override 는 카테고리(네임스페이스 접두사)별, 가장 긴 접두사가 우선
		// Verbose < Debug < Information < Warning < Error < Fatal
		"MinimumLevel": {
			// 지정되지 않은 모든 카테고리
			"Default": "Information",
			"Override": {
				// ASP.NET Core 프레임워크 내부 로그는 경고 이상만
				"Microsoft.AspNetCore": "Warning"
			}
		},
		// 콘솔은 Program.cs 코드에서 추가. 여기는 파일 저장만
		"WriteTo": [
			{
				"Name": "File",
				"Args": {
					// 날짜가 붙어 logs/log-20261029.jsonl 형태로 저장 (실행 디렉터리 기준)
					"path": "logs/log-.jsonl",
					"rollingInterval": "Day",
					// 최근 30개 파일만 보관
					"retainedFileCountLimit": 30,
					// 한 줄에 로그 하나씩 JSON 으로 기록
					"formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
				}
			},
			{
				"Name": "MSSqlServer",
				"Args": {
					// ConnectionStrings 의 키 이름 (로그 전용 DB: PersonManagerLogs)
					"connectionString": "LogsConnection",
					"sinkOptionsSection": {
						"tableName": "logs",
						// DB·테이블이 없으면 첫 실행 시 생성
						"autoCreateSqlDatabase": true,
						"autoCreateSqlTable": true,
						"batchPostingLimit": 1000,
						"batchPeriod": "0.00:00:05"
					},
					"columnOptionsSection": {
						// 속성 전체를 JSON 컬럼(LogEvent)으로 저장하고 XML 컬럼(Properties)은 제거
						"addStandardColumns": ["LogEvent"],
						"removeStandardColumns": ["Properties"]
					}
				}
			}
		]
	},
	"AllowedHosts": "*"
}
