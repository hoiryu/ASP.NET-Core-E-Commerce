<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../PersonManager.Core/PersonManager.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\Seeds\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
		<PackageReference Include="EntityFrameworkCore.Exceptions.SqlServer" Version="10.0.2" />
		<PackageReference Include="Gridify.EntityFramework" Version="2.20.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<!-- SqlClient 가 끌어오는 취약 버전(9.0.11) 대신 패치 버전 고정 -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>
</Project>
